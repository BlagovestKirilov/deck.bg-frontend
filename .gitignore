# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Android signing
android/keystore.properties
android/app/*.jks
android/app/*.keystore
*.jks
*.keystore

# Playwright — reports, traces and videos are build output, not source
/test-results
/playwright-report
/blob-report
/playwright/.cache

# Build output. The Dockerfile runs npm run build itself and serves that,
# so a committed bundle is never the one deployed.
/dist
